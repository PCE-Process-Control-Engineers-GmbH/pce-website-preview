Options -Indexes

DirectoryIndex index.html

ErrorDocument 404 /404.html

RewriteEngine On

# Canonical domain: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.pce-ei\.de$ [NC]
RewriteRule ^ https://pce-ei.de%{REQUEST_URI} [R=301,L]

# Defensive redirects for old /de URLs
RewriteRule ^de/?$ / [R=301,L]
RewriteRule ^de/(.+)$ /$1 [R=301,L]